# Local Prisma default; use each environment's secret manager outside local development.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54422/postgres"

# Replace every value with independent output from `openssl rand -base64 32`.
INTEGRATION_CREDENTIAL_KEYS_LOCAL='{"1":"REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY"}'
INTEGRATION_CREDENTIAL_ACTIVE_KEY_VERSION_LOCAL="1"
INTEGRATION_CREDENTIAL_KEYS_STG='{"1":"REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY"}'
INTEGRATION_CREDENTIAL_ACTIVE_KEY_VERSION_STG="1"
INTEGRATION_CREDENTIAL_KEYS_PRD='{"1":"REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY"}'
INTEGRATION_CREDENTIAL_ACTIVE_KEY_VERSION_PRD="1"
