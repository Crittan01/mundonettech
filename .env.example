# Local Prisma default; use each environment's secret manager outside local development.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54422/postgres"

# Replace every value with independent output from `openssl rand -base64 32`.
INTEGRATION_CREDENTIAL_KEYS_LOCAL='{"1":"REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY"}'
INTEGRATION_CREDENTIAL_ACTIVE_KEY_VERSION_LOCAL="1"
INTEGRATION_CREDENTIAL_KEYS_STG='{"1":"REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY"}'
INTEGRATION_CREDENTIAL_ACTIVE_KEY_VERSION_STG="1"
INTEGRATION_CREDENTIAL_KEYS_PRD='{"1":"REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY"}'
INTEGRATION_CREDENTIAL_ACTIVE_KEY_VERSION_PRD="1"

# Web/Auth configuration. Never commit real values.
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:4010"
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54421"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="REPLACE_WITH_ENVIRONMENT_PUBLISHABLE_KEY"
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_ENVIRONMENT_SERVICE_ROLE_KEY"
SESSION_TIMEOUT_SECRET="REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY"
SECURITY_EVENT_PEPPER="REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY"
RECOVERY_CODE_PEPPER="REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="REPLACE_WITH_TURNSTILE_SITE_KEY"
TURNSTILE_SECRET_KEY="REPLACE_WITH_TURNSTILE_SECRET_KEY"

# CMS media and scheduled publication. Use environment-specific secrets.
NEXT_PUBLIC_MEDIA_BASE_URL="https://media.example.co"
R2_ENDPOINT="https://REPLACE_WITH_R2_ACCOUNT.example"
R2_BUCKET="REPLACE_WITH_MEDIA_BUCKET"
R2_ACCESS_KEY_ID="REPLACE_WITH_R2_ACCESS_KEY"
R2_SECRET_ACCESS_KEY="REPLACE_WITH_R2_SECRET_KEY"
CMS_CRON_SECRET="REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY"
CMS_JOB_ACTOR_ID="REPLACE_WITH_ACTIVE_CMS_ADMIN_UUID"
