{
  "name": "@mundonettech/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build && node scripts/prepare-standalone.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 4010",
    "start": "PORT=4010 HOSTNAME=127.0.0.1 node --env-file-if-exists=.env.local .next/standalone/apps/web/server.js",
    "start:e2e": "PORT=4110 HOSTNAME=127.0.0.1 node .next/standalone/apps/web/server.js",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@mundonettech/config": "workspace:*",
    "@mundonettech/cms": "workspace:*",
    "@mundonettech/core": "workspace:*",
    "@mundonettech/db": "workspace:*",
    "@mundonettech/media": "workspace:*",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@vercel/functions": "^3.11.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.4.6",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}
