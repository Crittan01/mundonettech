{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!dist/**", "!.next/**"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true
    },
    "@mundonettech/db#typecheck": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "!dist/**", "!.next/**"]
    },
    "@mundonettech/media#typecheck": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "!dist/**", "!.next/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!dist/**", "!.next/**"]
    }
  }
}
