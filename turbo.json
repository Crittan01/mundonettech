{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*", "EMAIL_SEND_DISABLED"],
      "passThroughEnv": [
        "DATABASE_URL",
        "DIRECT_URL",
        "SITE_URL",
        "SUPABASE_URL",
        "SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "MEDIA_BASE_URL",
        "R2_ENDPOINT",
        "R2_BUCKET",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "SESSION_TIMEOUT_SECRET",
        "SECURITY_EVENT_PEPPER",
        "RECOVERY_CODE_PEPPER",
        "BANK_TRANSFER_INSTRUCTIONS",
        "CMS_CRON_SECRET",
        "CMS_JOB_ACTOR_ID",
        "ORDER_CRON_SECRET",
        "CRM_JOB_ACTOR_ID",
        "DOMAIN_WORKER_CRON_SECRET",
        "HEALTH_CRON_SECRET",
        "CHANNEL_CRON_SECRET",
        "CHANNEL_JOB_ACTOR_ID",
        "TURNSTILE_SECRET_KEY",
        "TURNSTILE_EXPECTED_HOSTNAME",
        "INTEGRATION_ENVIRONMENT",
        "INTEGRATION_CREDENTIAL_KEYS_*",
        "INTEGRATION_CREDENTIAL_ACTIVE_KEY_VERSION_*",
        "TRUSTED_PROXY",
        "VERCEL",
        "VERCEL_ENV"
      ],
      "inputs": ["$TURBO_DEFAULT$", "!dist/**", "!.next/**"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true
    },
    "@mundonettech/db#typecheck": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "!dist/**", "!.next/**"]
    },
    "@mundonettech/media#typecheck": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "!dist/**", "!.next/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!dist/**", "!.next/**"]
    }
  }
}
