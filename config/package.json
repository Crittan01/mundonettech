{
  "name": "@mundonettech/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./store": {
      "types": "./dist/store.config.d.ts",
      "import": "./dist/store.config.js"
    },
    "./theme": {
      "types": "./dist/theme.config.d.ts",
      "import": "./dist/theme.config.js"
    },
    "./catalog": {
      "types": "./dist/catalog-blueprint.d.ts",
      "import": "./dist/catalog-blueprint.js"
    },
    "./seed": {
      "types": "./dist/catalog-seed.d.ts",
      "import": "./dist/catalog-seed.js"
    },
    "./legal": {
      "types": "./dist/legal.config.d.ts",
      "import": "./dist/legal.config.js"
    },
    "./help": {
      "types": "./dist/help-center.config.d.ts",
      "import": "./dist/help-center.config.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
