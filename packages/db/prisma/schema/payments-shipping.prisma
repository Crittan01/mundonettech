enum PaymentProvider {
  WOMPI
  COD
  BANK_TRANSFER
  STORE_CREDIT
}

enum PaymentAttemptStatus {
  REQUIRES_ACTION
  PENDING
  PROCESSING
  AUTHORIZED
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentTransactionKind {
  CAPTURE
  REFUND
  VOID
}

enum PaymentTransactionStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PaymentWebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum CodReconciliationStatus {
  PENDING_COLLECTION
  COLLECTED
  REMITTED
  RECONCILED
  DISCREPANCY
  CANCELLED
}

enum RemittanceBatchStatus {
  OPEN
  CLOSED
  RECONCILED
  DISCREPANCY
  CANCELLED
}

enum BlockedIdentityKind {
  EMAIL
  PHONE
  DOCUMENT
}

enum StoreCreditEntryType {
  GRANT
  WITHDRAWAL
  HOLD
  CAPTURE
  RELEASE
  REFUND
}

enum ShipmentKind {
  DELIVERY
  CLICK_COLLECT
}

enum ShipmentStatus {
  PENDING
  READY
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ShippingProviderCode {
  AVEONLINE
  FLEX
  PICKUP
}

enum OrderFulfillmentStatus {
  PENDING
  PICKING
  PACKED
  LABELLED
  SHIPPED
  DELIVERED
  CANCELLED
  RECONCILING
}

enum ShipmentPackageStatus {
  SEALED
  CLAIMED
  LABELLED
  SHIPPED
  DELIVERED
  CANCELLED
  RECONCILING
}

enum ShipmentEventType {
  FULFILLMENT_CREATED
  PICKING_STARTED
  PACKAGE_SEALED
  LABEL_CLAIMED
  LABEL_GENERATED
  PROVIDER_REJECTED
  PROVIDER_UNCERTAIN
  SHIPPED
  DELIVERED
  CANCELLED
  NOTE
}

enum OrderRefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
  CANCELLED
}

enum OrderRefundReason {
  RETRACT
  WARRANTY
  ADJUSTMENT
  CUSTOMER_SUPPORT
}

model LocalDeliveryZone {
  id                         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                       String     @db.VarChar(40)
  name                       String     @db.VarChar(120)
  active                     Boolean    @default(true)
  municipalityCodes          Json       @db.JsonB
  polygon                    Json       @db.JsonB
  baseFeeCents               BigInt
  freeShippingThresholdCents BigInt?
  cutoffMinutes              Int
  deliveryPromiseMinutes     Int
  createdByAdminUserId       String     @db.Uuid
  updatedByAdminUserId       String     @db.Uuid
  createdAt                  DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  deletedAt                  DateTime?  @db.Timestamptz(6)
  createdBy                  AdminUser  @relation("DeliveryZoneCreator", fields: [createdByAdminUserId], references: [id], onDelete: Restrict)
  updatedBy                  AdminUser  @relation("DeliveryZoneUpdater", fields: [updatedByAdminUserId], references: [id], onDelete: Restrict)
  shipments                  Shipment[]

  @@index([active, deletedAt])
  @@map("LocalDeliveryZone")
}

model Shipment {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId              String             @db.Uuid
  originLocationId     String             @db.Uuid
  localDeliveryZoneId  String?            @db.Uuid
  kind                 ShipmentKind
  status               ShipmentStatus     @default(PENDING)
  trackingCode         String?            @db.VarChar(120)
  carrier              String?            @db.VarChar(120)
  localDriverName      String?            @db.VarChar(200)
  localDriverPhoneE164 String?            @db.VarChar(16)
  shippingCents        BigInt             @default(0)
  promisedAt           DateTime           @db.Timestamptz(6)
  readyAt              DateTime?          @db.Timestamptz(6)
  shippedAt            DateTime?          @db.Timestamptz(6)
  deliveredAt          DateTime?          @db.Timestamptz(6)
  cancelledAt          DateTime?          @db.Timestamptz(6)
  createdAt            DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  order                Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  originLocation       StockLocation      @relation(fields: [originLocationId], references: [id], onDelete: Restrict)
  localDeliveryZone    LocalDeliveryZone? @relation(fields: [localDeliveryZoneId], references: [id], onDelete: Restrict)
  items                ShipmentItem[]
  fulfillment          OrderFulfillment?
  packages             ShipmentPackage[]
  events               ShipmentEvent[]
  serializedUnits      SerializedUnit[]

  @@index([orderId, status, createdAt])
  @@index([originLocationId, status])
  @@index([status, promisedAt])
  @@index([localDeliveryZoneId, status])
  @@map("Shipment")
}

model ShipmentItem {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipmentId         String                @db.Uuid
  orderItemId        String                @db.Uuid
  quantity           Int
  declaredValueCents BigInt?
  createdAt          DateTime              @default(now()) @db.Timestamptz(6)
  shipment           Shipment              @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  orderItem          OrderItem             @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  packageItems       ShipmentPackageItem[]
  returnRequestItems ReturnRequestItem[]

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId, shipmentId])
  @@map("ShipmentItem")
}

model OrderFulfillment {
  id           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String                  @db.Uuid
  shipmentId   String                  @unique @db.Uuid
  provider     ShippingProviderCode
  status       OrderFulfillmentStatus  @default(PENDING)
  credentialId String?                 @db.Uuid
  environment  IntegrationEnvironment?
  version      Int                     @default(0)
  createdAt    DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  order        Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shipment     Shipment                @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  credential   IntegrationCredential?  @relation(fields: [credentialId], references: [id], onDelete: Restrict)

  @@index([orderId, status, createdAt])
  @@index([status, provider, createdAt])
  @@index([credentialId, status])
  @@map("OrderFulfillment")
}

model ShipmentPackage {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipmentId         String                 @db.Uuid
  packageNumber      Int
  status             ShipmentPackageStatus  @default(SEALED)
  weightGrams        Int
  lengthMillimeters  Int
  widthMillimeters   Int
  heightMillimeters  Int
  declaredValueCents BigInt
  requestKey         String                 @unique @db.VarChar(128)
  requestHash        Bytes                  @db.ByteA
  credentialId       String?                @db.Uuid
  providerReference  String?                @db.VarChar(128)
  trackingCode       String?                @unique @db.VarChar(120)
  labelUrl           String?                @db.VarChar(2048)
  claimedBy          String?                @db.VarChar(120)
  claimedAt          DateTime?              @db.Timestamptz(6)
  claimExpiresAt     DateTime?              @db.Timestamptz(6)
  requestStartedAt   DateTime?              @db.Timestamptz(6)
  lastError          String?                @db.VarChar(1000)
  labelledAt         DateTime?              @db.Timestamptz(6)
  shippedAt          DateTime?              @db.Timestamptz(6)
  deliveredAt        DateTime?              @db.Timestamptz(6)
  cancelledAt        DateTime?              @db.Timestamptz(6)
  createdAt          DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  shipment           Shipment               @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  credential         IntegrationCredential? @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  items              ShipmentPackageItem[]
  events             ShipmentEvent[]

  @@unique([shipmentId, packageNumber])
  @@index([status, claimExpiresAt, createdAt])
  @@index([credentialId, status])
  @@map("ShipmentPackage")
}

model ShipmentPackageItem {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageId          String          @db.Uuid
  shipmentItemId     String          @db.Uuid
  quantity           Int
  declaredValueCents BigInt
  createdAt          DateTime        @default(now()) @db.Timestamptz(6)
  package            ShipmentPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  shipmentItem       ShipmentItem    @relation(fields: [shipmentItemId], references: [id], onDelete: Restrict)

  @@unique([packageId, shipmentItemId])
  @@index([shipmentItemId, packageId])
  @@map("ShipmentPackageItem")
}

model ShipmentEvent {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipmentId       String            @db.Uuid
  packageId        String?           @db.Uuid
  actorAdminUserId String?           @db.Uuid
  type             ShipmentEventType
  eventKey         String            @unique @db.VarChar(128)
  providerEventId  String?           @db.VarChar(128)
  payloadHash      Bytes?            @db.ByteA
  metadata         Json              @default("{}") @db.JsonB
  occurredAt       DateTime          @default(now()) @db.Timestamptz(6)
  shipment         Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  package          ShipmentPackage?  @relation(fields: [packageId], references: [id], onDelete: Restrict)
  actor            AdminUser?        @relation(fields: [actorAdminUserId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, providerEventId])
  @@index([shipmentId, occurredAt, id])
  @@index([packageId, occurredAt])
  @@map("ShipmentEvent")
}

model OrderRefund {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                String               @db.Uuid
  idempotencyKey         String               @unique @db.VarChar(128)
  requestHash            Bytes                @db.ByteA
  reason                 OrderRefundReason
  status                 OrderRefundStatus    @default(REQUESTED)
  subtotalCents          BigInt
  taxCents               BigInt
  shippingCents          BigInt               @default(0)
  totalCents             BigInt
  note                   String?              @db.VarChar(500)
  requestedByAdminUserId String               @db.Uuid
  processedAt            DateTime?            @db.Timestamptz(6)
  createdAt              DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  order                  Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  requestedBy            AdminUser            @relation(fields: [requestedByAdminUserId], references: [id], onDelete: Restrict)
  items                  OrderRefundItem[]
  paymentTransactions    PaymentTransaction[]
  storeCreditEntries     StoreCreditEntry[]
  creditNote             CreditNote?
  returnRequest          ReturnRequest?
  warrantyClaim          WarrantyClaim?

  @@index([orderId, status, createdAt])
  @@index([requestedByAdminUserId, createdAt])
  @@map("OrderRefund")
}

model OrderRefundItem {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  refundId      String      @db.Uuid
  orderItemId   String      @db.Uuid
  quantity      Int
  subtotalCents BigInt
  taxCents      BigInt
  totalCents    BigInt
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)
  refund        OrderRefund @relation(fields: [refundId], references: [id], onDelete: Restrict)
  orderItem     OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([refundId, orderItemId])
  @@index([orderItemId, refundId])
  @@map("OrderRefundItem")
}

model PaymentAttempt {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                String                 @db.Uuid
  provider               PaymentProvider
  environment            IntegrationEnvironment
  status                 PaymentAttemptStatus   @default(PENDING)
  idempotencyKey         String                 @db.VarChar(128)
  requestHash            Bytes                  @db.ByteA
  reference              String                 @unique @db.VarChar(64)
  amountCents            BigInt
  currency               String                 @default("COP") @db.Char(3)
  credentialId           String?                @db.Uuid
  storeCreditAccountId   String?                @db.Uuid
  providerStatus         String?                @db.VarChar(40)
  providerOccurredAt     DateTime?              @db.Timestamptz(6)
  failureCode            String?                @db.VarChar(100)
  expiresAt              DateTime?              @db.Timestamptz(6)
  confirmedByAdminUserId String?                @db.Uuid
  confirmedAt            DateTime?              @db.Timestamptz(6)
  completedAt            DateTime?              @db.Timestamptz(6)
  createdAt              DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  order                  Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  credential             IntegrationCredential? @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  storeCreditAccount     StoreCreditAccount?    @relation(fields: [storeCreditAccountId], references: [id], onDelete: Restrict)
  confirmedBy            AdminUser?             @relation("PaymentAttemptConfirmer", fields: [confirmedByAdminUserId], references: [id], onDelete: Restrict)
  transactions           PaymentTransaction[]
  webhookEvents          PaymentWebhookEvent[]
  codReconciliation      CodReconciliation?
  storeCreditEntries     StoreCreditEntry[]

  @@unique([orderId, idempotencyKey])
  @@index([orderId, status, createdAt])
  @@index([provider, status, expiresAt])
  @@index([credentialId, createdAt])
  @@index([storeCreditAccountId, status])
  @@map("PaymentAttempt")
}

model PaymentTransaction {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId         String                   @db.Uuid
  refundId          String?                  @db.Uuid
  provider          PaymentProvider
  kind              PaymentTransactionKind
  status            PaymentTransactionStatus @default(PENDING)
  amountCents       BigInt
  externalId        String?                  @db.VarChar(128)
  providerReference String?                  @db.VarChar(255)
  requestHash       Bytes                    @db.ByteA
  statusMessage     String?                  @db.VarChar(500)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)
  completedAt       DateTime?                @db.Timestamptz(6)
  attempt           PaymentAttempt           @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  refund            OrderRefund?             @relation(fields: [refundId], references: [id], onDelete: Restrict)

  @@unique([provider, kind, externalId])
  @@index([attemptId, kind, status, createdAt])
  @@index([refundId, status, createdAt])
  @@index([provider, externalId])
  @@map("PaymentTransaction")
}

model PaymentWebhookEvent {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider              PaymentProvider
  attemptId             String?              @db.Uuid
  eventKey              String               @db.Char(64)
  payloadHash           Bytes                @db.ByteA
  transactionExternalId String?              @db.VarChar(128)
  status                PaymentWebhookStatus @default(RECEIVED)
  errorCode             String?              @db.VarChar(100)
  receivedAt            DateTime             @default(now()) @db.Timestamptz(6)
  processedAt           DateTime?            @db.Timestamptz(6)
  attempt               PaymentAttempt?      @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@unique([provider, eventKey])
  @@index([attemptId, receivedAt])
  @@index([status, receivedAt])
  @@map("PaymentWebhookEvent")
}

model BlockedIdentity {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind                   BlockedIdentityKind
  identityHash           Bytes               @db.ByteA
  reason                 String              @db.VarChar(500)
  active                 Boolean             @default(true)
  expiresAt              DateTime?           @db.Timestamptz(6)
  blockedByAdminUserId   String              @db.Uuid
  blockedAt              DateTime            @default(now()) @db.Timestamptz(6)
  unblockedByAdminUserId String?             @db.Uuid
  unblockedAt            DateTime?           @db.Timestamptz(6)
  blockedBy              AdminUser           @relation("IdentityBlocker", fields: [blockedByAdminUserId], references: [id], onDelete: Restrict)
  unblockedBy            AdminUser?          @relation("IdentityUnblocker", fields: [unblockedByAdminUserId], references: [id], onDelete: Restrict)

  @@index([kind, identityHash, active, expiresAt])
  @@index([blockedByAdminUserId, blockedAt])
  @@map("BlockedIdentity")
}

model RemittanceBatch {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  carrier              String                @db.VarChar(120)
  reference            String                @unique @db.VarChar(128)
  requestHash          Bytes                 @db.ByteA
  status               RemittanceBatchStatus @default(OPEN)
  expectedCents        BigInt                @default(0)
  receivedCents        BigInt                @default(0)
  receivedAt           DateTime?             @db.Timestamptz(6)
  createdByAdminUserId String                @db.Uuid
  createdAt            DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  createdBy            AdminUser             @relation(fields: [createdByAdminUserId], references: [id], onDelete: Restrict)
  reconciliations      CodReconciliation[]

  @@index([carrier, status, createdAt])
  @@map("RemittanceBatch")
}

model CodReconciliation {
  id                      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentAttemptId        String                  @unique @db.Uuid
  remittanceBatchId       String?                 @db.Uuid
  status                  CodReconciliationStatus @default(PENDING_COLLECTION)
  expectedCents           BigInt
  collectedCents          BigInt                  @default(0)
  remittedCents           BigInt                  @default(0)
  carrierReference        String?                 @db.VarChar(128)
  collectedAt             DateTime?               @db.Timestamptz(6)
  remittedAt              DateTime?               @db.Timestamptz(6)
  reconciledAt            DateTime?               @db.Timestamptz(6)
  reconciledByAdminUserId String?                 @db.Uuid
  createdAt               DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  paymentAttempt          PaymentAttempt          @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  remittanceBatch         RemittanceBatch?        @relation(fields: [remittanceBatchId], references: [id], onDelete: Restrict)
  reconciledBy            AdminUser?              @relation(fields: [reconciledByAdminUserId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([remittanceBatchId, status])
  @@map("CodReconciliation")
}

model StoreCreditAccount {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId      String             @db.Uuid
  currency        String             @default("COP") @db.Char(3)
  availableCents  BigInt             @default(0)
  heldCents       BigInt             @default(0)
  active          Boolean            @default(true)
  version         Int                @default(0)
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  customer        Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  paymentAttempts PaymentAttempt[]
  entries         StoreCreditEntry[]

  @@unique([customerId, currency])
  @@index([active, updatedAt])
  @@map("StoreCreditAccount")
}

model StoreCreditEntry {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId           String               @db.Uuid
  paymentAttemptId    String?              @db.Uuid
  refundId            String?              @db.Uuid
  actorAdminUserId    String?              @db.Uuid
  type                StoreCreditEntryType
  operationKey        String               @unique @db.VarChar(128)
  sequence            Int
  requestHash         Bytes                @db.ByteA
  amountCents         BigInt
  availableAfterCents BigInt
  heldAfterCents      BigInt
  reason              String               @db.VarChar(500)
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  account             StoreCreditAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  paymentAttempt      PaymentAttempt?      @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  refund              OrderRefund?         @relation(fields: [refundId], references: [id], onDelete: Restrict)
  actor               AdminUser?           @relation(fields: [actorAdminUserId], references: [id], onDelete: Restrict)

  @@unique([accountId, sequence])
  @@index([accountId, createdAt, id])
  @@index([paymentAttemptId, type])
  @@index([refundId, type])
  @@map("StoreCreditEntry")
}
