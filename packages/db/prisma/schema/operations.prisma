  account            ChannelAccount           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  pack               ChannelPack?             @relation(fields: [packId], references: [id], onDelete: Restrict)
  order              ChannelOrder?            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdBy          AdminUser?               @relation("ChannelLedgerEntryCreator", fields: [createdByAdminUserId], references: [id], onDelete: Restrict)

  @@index([accountId, occurredAt, id], map: "ChannelLedgerEntry_account_occurred_idx")
  @@index([orderId, entryType, occurredAt, id], map: "ChannelLedgerEntry_order_type_occurred_idx")
  @@index([packId, entryType, occurredAt, id], map: "ChannelLedgerEntry_pack_type_occurred_idx")
  @@index([externalPaymentId, entryType], map: "ChannelLedgerEntry_payment_type_idx")
  @@map("ChannelLedgerEntry")
}

enum MetaCapiEventName {
  PURCHASE
}

enum MetaCapiEventStatus {
  PENDING
  DISPATCHING
  SENT
  SKIPPED
  FAILED
  UNCERTAIN
}

model MetaCapiEvent {
  id                       String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId                  String                @unique @db.VarChar(128)
  eventName                MetaCapiEventName
  status                   MetaCapiEventStatus   @default(PENDING)
  environment              IntegrationEnvironment
  credentialId             String                @db.Uuid
  orderId                  String                @unique @db.Uuid
  customerId               String                @db.Uuid
  consentId                String                @db.Uuid
  pixelId                  String                @db.VarChar(32)
  requestUrl               String                @db.VarChar(2048)
  testEventCode            String?               @db.VarChar(100)
  eventTime                DateTime              @db.Timestamptz(6)
  eventSourceUrl           String                @db.VarChar(2048)
  valueCents               BigInt
  currency                 String                @default("COP") @db.Char(3)
  contents                 Json                  @db.JsonB
  requestHash              Bytes                 @db.ByteA
  externalIdHash           Bytes?                @db.ByteA
  emailHash                Bytes?                @db.ByteA
  phoneHash                Bytes?                @db.ByteA
  attempts                 Int                   @default(0)
  availableAt              DateTime              @default(now()) @db.Timestamptz(6)
  claimId                  String?               @db.Uuid
  claimedBy                String?               @db.VarChar(120)
  claimedAt                DateTime?             @db.Timestamptz(6)
  claimExpiresAt           DateTime?             @db.Timestamptz(6)
  requestStartedAt         DateTime?             @db.Timestamptz(6)
  sentAt                   DateTime?             @db.Timestamptz(6)
  completedAt              DateTime?             @db.Timestamptz(6)
  providerTraceId          String?               @db.VarChar(128)
  failureCode              String?               @db.VarChar(100)
  reconciliationReference  String?               @db.VarChar(128)
  reconciledAt             DateTime?             @db.Timestamptz(6)
  reconciledByAdminUserId  String?               @db.Uuid
  version                  Int                   @default(0)
  createdAt                DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  credential               IntegrationCredential @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  order                    Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer                 Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  consent                  Consent               @relation(fields: [consentId], references: [id], onDelete: Restrict)
  reconciledBy             AdminUser?            @relation("MetaCapiReconciler", fields: [reconciledByAdminUserId], references: [id], onDelete: Restrict)

  @@index([status, availableAt, id], map: "MetaCapiEvent_status_available_id_idx")
  @@index([customerId, status], map: "MetaCapiEvent_customer_status_idx")
  @@index([consentId])
  @@index([claimExpiresAt, status], map: "MetaCapiEvent_claim_expiry_status_idx")
  @@index([environment, status])
  @@index([reconciledByAdminUserId, createdAt], map: "MetaCapiEvent_reconciler_created_idx")
  @@map("MetaCapiEvent")
}
