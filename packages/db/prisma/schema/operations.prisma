enum IdempotencyStatus {
  PROCESSING
  SUCCEEDED
  FAILED
}

model DomainOutbox {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType        String    @db.VarChar(120)
  aggregateType    String    @db.VarChar(100)
  aggregateId      String    @db.VarChar(128)
  deduplicationKey String    @db.VarChar(255)
  payload          Json      @db.JsonB
  occurredAt       DateTime  @default(now()) @db.Timestamptz(6)
  availableAt      DateTime  @default(now()) @db.Timestamptz(6)
  claimedAt        DateTime? @db.Timestamptz(6)
  claimedBy        String?   @db.VarChar(120)
  claimExpiresAt   DateTime? @db.Timestamptz(6)
  processedAt      DateTime? @db.Timestamptz(6)
  failedAt         DateTime? @db.Timestamptz(6)
  attempts         Int       @default(0)
  lastError        String?   @db.VarChar(2000)

  @@unique([deduplicationKey])
  @@index([processedAt, availableAt, claimExpiresAt])
  @@index([aggregateType, aggregateId, occurredAt])
  @@map("DomainOutbox")
}

model IdempotencyKey {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope          String            @db.VarChar(120)
  keyHash        Bytes             @db.ByteA
  subjectHash    Bytes             @db.ByteA
  requestHash    Bytes             @db.ByteA
  status         IdempotencyStatus @default(PROCESSING)
  responseStatus Int?
  resultType     String?           @db.VarChar(100)
  resultId       String?           @db.VarChar(255)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  expiresAt      DateTime          @db.Timestamptz(6)
  completedAt    DateTime?         @db.Timestamptz(6)

  @@unique([scope, keyHash])
  @@index([expiresAt, status])
  @@index([subjectHash, createdAt])
  @@map("IdempotencyKey")
}

model DailyFunnelMetric {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  metricDate      DateTime @db.Date
  source          String   @default("STOREFRONT") @db.VarChar(30)
  pageViews       BigInt   @default(0)
  productViews    BigInt   @default(0)
  cartAdditions   BigInt   @default(0)
  checkoutStarts  BigInt   @default(0)
  ordersConfirmed BigInt   @default(0)
  ordersPaid      BigInt   @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([metricDate, source])
  @@index([metricDate])
  @@map("DailyFunnelMetric")
}

enum FiscalWatchStatus {
  WITHIN_LIMIT
  APPROACHING_LIMIT
  THRESHOLD_REACHED
}

model FiscalWatchSnapshot {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fiscalYear          Int
  snapshotDate        DateTime          @db.Date
  uvtYear             Int
  uvtValueCents       BigInt
  thresholdUvt        Int               @default(3500)
  thresholdCents      BigInt
  grossCapturedCents  BigInt            @default(0)
  refundedCents       BigInt            @default(0)
  netRevenueCents     BigInt            @default(0)
  refundExcessCents   BigInt            @default(0)
  remainingCents      BigInt
  status              FiscalWatchStatus
  thresholdReachedAt  DateTime?         @db.Timestamptz(6)
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime          @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([fiscalYear, snapshotDate])
  @@index([status, snapshotDate])
  @@map("FiscalWatchSnapshot")
}

enum RecoveryRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum OperationalHealthStatus {
  HEALTHY
  DEGRADED
  CRITICAL
}

model BackupRun {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  environment         IntegrationEnvironment
  status              RecoveryRunStatus     @default(RUNNING)
  startedAt           DateTime              @default(now()) @db.Timestamptz(6)
  completedAt         DateTime?             @db.Timestamptz(6)
  storageKey          String?               @unique @db.VarChar(512)
  manifestKey         String?               @unique @db.VarChar(512)
  byteSize            BigInt?
  encryptedSha256     Bytes?                @db.ByteA
  authSchemaVerified  Boolean               @default(false)
  failureCode         String?               @db.VarChar(120)
  bucketChecks        RecoveryBucketCheck[]
  disasterRecoveryRuns DisasterRecoveryDrill[]

  @@index([environment, status, startedAt])
  @@index([startedAt])
  @@map("BackupRun")
}

model DisasterRecoveryDrill {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  backupRunId           String                @db.Uuid
  environment           IntegrationEnvironment
  status                RecoveryRunStatus     @default(RUNNING)
  startedAt             DateTime              @default(now()) @db.Timestamptz(6)
  completedAt           DateTime?             @db.Timestamptz(6)
  authSchemaVerified    Boolean               @default(false)
  verifiedRelationCount Int                   @default(0)
  nextDueAt             DateTime?             @db.Timestamptz(6)
  failureCode           String?               @db.VarChar(120)
  backupRun             BackupRun             @relation(fields: [backupRunId], references: [id], onDelete: Restrict)
  bucketChecks          RecoveryBucketCheck[]

  @@index([environment, status, startedAt])
  @@index([startedAt])
  @@map("DisasterRecoveryDrill")
}

model RecoveryBucketCheck {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  backupRunId             String?                @db.Uuid
  disasterRecoveryDrillId String?                @db.Uuid
  bucketName              String                 @db.VarChar(63)
  accessible              Boolean
  readVerified            Boolean                @default(false)
  objectCount             BigInt?
  checkedAt               DateTime               @default(now()) @db.Timestamptz(6)
  backupRun               BackupRun?             @relation(fields: [backupRunId], references: [id], onDelete: Restrict)
  disasterRecoveryDrill   DisasterRecoveryDrill? @relation(fields: [disasterRecoveryDrillId], references: [id], onDelete: Restrict)

  @@unique([backupRunId, bucketName])
  @@unique([disasterRecoveryDrillId, bucketName])
  @@index([backupRunId])
  @@index([disasterRecoveryDrillId])
  @@map("RecoveryBucketCheck")
}

model OperationalHealthSnapshot {
  id                       String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  environment              IntegrationEnvironment
  captureKey               String                 @db.VarChar(15)
  capturedAt               DateTime               @default(now()) @db.Timestamptz(6)
  status                   OperationalHealthStatus
  databaseReady            Boolean
  databaseLatencyMs        Int
  pendingOutbox            Int                    @default(0)
  failedOutbox             Int                    @default(0)
  oldestPendingOutboxAt    DateTime?              @db.Timestamptz(6)
  latestSuccessfulBackupAt DateTime?              @db.Timestamptz(6)
  latestSuccessfulDrillAt  DateTime?              @db.Timestamptz(6)

  @@unique([environment, captureKey])
  @@index([environment, capturedAt])
  @@index([status, capturedAt])
  @@map("OperationalHealthSnapshot")
}

enum ChannelProvider {
  MERCADO_LIBRE
}

enum ChannelAccountStatus {
  ACTIVE
  REAUTH_REQUIRED
  DISCONNECTED
}

enum ChannelOAuthAttemptStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

model ChannelAccount {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider              ChannelProvider
  siteId                String                 @db.VarChar(3)
  environment           IntegrationEnvironment
  credentialId          String                 @unique @db.Uuid
  externalAccountId     String                 @db.VarChar(64)
  label                 String                 @db.VarChar(120)
  status                ChannelAccountStatus   @default(ACTIVE)
  scopes                String[]
  tokenExpiresAt        DateTime?              @db.Timestamptz(6)
  lastRefreshedAt       DateTime?              @db.Timestamptz(6)
  lastRefreshError      String?                @db.VarChar(100)
  refreshClaimId        String?                @db.Uuid
  refreshClaimedAt      DateTime?              @db.Timestamptz(6)
  refreshClaimExpiresAt DateTime?              @db.Timestamptz(6)
  version               Int                    @default(0)
  connectedAt           DateTime               @default(now()) @db.Timestamptz(6)
  disconnectedAt        DateTime?              @db.Timestamptz(6)
  createdByAdminUserId  String                 @db.Uuid
  createdAt             DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  credential            IntegrationCredential  @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  createdBy             AdminUser              @relation("ChannelAccountCreator", fields: [createdByAdminUserId], references: [id], onDelete: Restrict)
  oauthAttempts         ChannelOAuthAttempt[]

  @@unique([provider, siteId, environment, externalAccountId])
  @@index([environment, status, tokenExpiresAt, id])
  @@index([createdByAdminUserId, createdAt])
  @@map("ChannelAccount")
}

model ChannelOAuthAttempt {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String?                 @db.Uuid
  provider              ChannelProvider
  siteId                String                  @db.VarChar(3)
  environment           IntegrationEnvironment
  credentialId          String                  @unique @db.Uuid
  label                 String                  @db.VarChar(120)
  stateHash             Bytes                   @unique @db.ByteA
  status                ChannelOAuthAttemptStatus @default(PENDING)
  expiresAt             DateTime                @db.Timestamptz(6)
  claimedAt             DateTime?               @db.Timestamptz(6)
  completedAt           DateTime?               @db.Timestamptz(6)
  failureCode           String?                 @db.VarChar(100)
  createdByAdminUserId  String                  @db.Uuid
  createdAt             DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  account               ChannelAccount?         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  credential            IntegrationCredential   @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  createdBy             AdminUser               @relation("ChannelOAuthAttemptCreator", fields: [createdByAdminUserId], references: [id], onDelete: Restrict)

  @@index([environment, status, expiresAt])
  @@index([accountId, createdAt])
  @@index([createdByAdminUserId, createdAt])
  @@map("ChannelOAuthAttempt")
}
