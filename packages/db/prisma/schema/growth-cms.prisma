enum StoreTaxRegime {
  NO_RESPONSABLE_IVA
  RESPONSABLE_IVA
}

enum CmsPageStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum CmsBlockVersionStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

model StoreSettings {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                    String         @unique @db.VarChar(40)
  taxRegime              StoreTaxRegime
  annualRevenueAlertUvt  Int
  currency               String         @db.Char(3)
  timeZone               String         @db.VarChar(64)
  orderNumberPrefix      String         @db.VarChar(12)
  orderNumberPadding     Int
  uvtValueCents          BigInt         @default(5237400)
  uvtYear                Int            @default(2026)
  standardShippingCents  BigInt         @default(0)
  deliveryPromiseDays    Int            @default(30)
  reservationMinutes     Int            @default(120)
  clickAndCollectEnabled Boolean        @default(false)
  localDeliveryEnabled   Boolean        @default(false)
  updatedByAdminUserId   String?        @db.Uuid
  createdAt              DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  updatedBy              AdminUser?     @relation(fields: [updatedByAdminUserId], references: [id], onDelete: Restrict)

  @@map("StoreSettings")
}

model CmsPage {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String            @db.VarChar(160)
  title          String            @db.VarChar(200)
  seoTitle       String?           @db.VarChar(200)
  seoDescription String?           @db.VarChar(300)
  status         CmsPageStatus     @default(DRAFT)
  publishedAt    DateTime?         @db.Timestamptz(6)
  scheduledFor   DateTime?         @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?         @db.Timestamptz(6)
  blocks         CmsSectionBlock[]

  @@index([status, scheduledFor])
  @@index([deletedAt])
  @@map("CmsPage")
}

model CmsSectionBlock {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageId    String            @db.Uuid
  blockType String            @db.VarChar(40)
  position  Int
  isVisible Boolean           @default(true)
  createdAt DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  page      CmsPage           @relation(fields: [pageId], references: [id], onDelete: Restrict)
  versions  CmsBlockVersion[]

  @@unique([pageId, position])
  @@index([pageId, isVisible, position])
  @@map("CmsSectionBlock")
}

model CmsBlockVersion {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockId              String                @db.Uuid
  version              Int
  content              Json                  @db.JsonB
  contentHash          Bytes                 @db.ByteA
  status               CmsBlockVersionStatus @default(DRAFT)
  effectiveAt          DateTime?             @db.Timestamptz(6)
  publishedAt          DateTime?             @db.Timestamptz(6)
  createdByAdminUserId String                @db.Uuid
  createdAt            DateTime              @default(now()) @db.Timestamptz(6)
  block                CmsSectionBlock       @relation(fields: [blockId], references: [id], onDelete: Restrict)
  createdBy            AdminUser             @relation(fields: [createdByAdminUserId], references: [id], onDelete: Restrict)

  @@unique([blockId, version])
  @@index([blockId, status, effectiveAt, version])
  @@index([status, effectiveAt])
  @@map("CmsBlockVersion")
}

enum EmailTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EmailEventStatus {
  QUEUED
  SENDING
  SENT
  DELIVERY_DELAYED
  DELIVERED
  BOUNCED
  COMPLAINED
  SUPPRESSED
  CANCELLED
  FAILED
}

enum EmailSuppressionReason {
  UNSUBSCRIBE
  BOUNCE
  COMPLAINT
  MANUAL
}

model EmailTemplateOverride {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateKey          String              @db.VarChar(80)
  locale               String              @db.VarChar(10)
  version              Int
  status               EmailTemplateStatus @default(DRAFT)
  subject              String              @db.VarChar(200)
  htmlBody             String              @db.Text
  textBody             String              @db.Text
  variables            Json                @default("[]") @db.JsonB
  createdByAdminUserId String              @db.Uuid
  createdAt            DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  createdBy            AdminUser           @relation(fields: [createdByAdminUserId], references: [id], onDelete: Restrict)

  @@unique([templateKey, locale, version])
  @@index([templateKey, locale, status, version])
  @@map("EmailTemplateOverride")
}

model EmailEvent {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId              String?               @db.Uuid
  customerId           String?               @db.Uuid
  abandonedCartId      String?               @db.Uuid
  credentialId         String                @db.Uuid
  templateKey          String                @db.VarChar(80)
  locale               String                @default("es-CO") @db.VarChar(10)
  topic                String                @db.VarChar(80)
  subjectSnapshot      String                @db.VarChar(200)
  htmlBodySnapshot     String                @db.Text
  textBodySnapshot     String                @db.Text
  variablesSnapshot    Json                  @db.JsonB
  recipientEmail       String                @db.VarChar(320)
  recipientHash        Bytes                 @db.ByteA
  idempotencyKey       String                @unique @db.VarChar(128)
  unsubscribeTokenHash Bytes                 @db.ByteA
  status               EmailEventStatus      @default(QUEUED)
  statusRank           Int                   @default(0)
  attemptCount         Int                   @default(0)
  nextAttemptAt        DateTime?             @db.Timestamptz(6)
  providerMessageId    String?               @db.VarChar(128)
  lastError            String?               @db.VarChar(1000)
  queuedAt             DateTime              @default(now()) @db.Timestamptz(6)
  sentAt               DateTime?             @db.Timestamptz(6)
  deliveredAt          DateTime?             @db.Timestamptz(6)
  finalAt              DateTime?             @db.Timestamptz(6)
  anonymizedAt         DateTime?             @db.Timestamptz(6)
  createdAt            DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  order                Order?                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer             Customer?             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  abandonedCart        AbandonedCart?        @relation(fields: [abandonedCartId], references: [id], onDelete: Restrict)
  credential           IntegrationCredential @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  webhookEvents        EmailWebhookEvent[]
  suppressions         EmailSuppression[]

  @@unique([credentialId, providerMessageId])
  @@index([status, nextAttemptAt, queuedAt])
  @@index([recipientHash, topic, createdAt])
  @@index([orderId, createdAt])
  @@index([customerId, templateKey, createdAt])
  @@index([abandonedCartId, createdAt])
  @@map("EmailEvent")
}

model EmailSuppression {
  id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientHash Bytes                  @db.ByteA
  topic         String                 @db.VarChar(80)
  reason        EmailSuppressionReason
  sourceEventId String?                @db.Uuid
  createdAt     DateTime               @default(now()) @db.Timestamptz(6)
  sourceEvent   EmailEvent?            @relation(fields: [sourceEventId], references: [id], onDelete: Restrict)

  @@unique([recipientHash, topic])
  @@index([sourceEventId])
  @@map("EmailSuppression")
}

model EmailWebhookEvent {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  credentialId String                @db.Uuid
  emailEventId String?               @db.Uuid
  svixEventId  String                @db.VarChar(128)
  eventType    String                @db.VarChar(80)
  payloadHash  Bytes                 @db.ByteA
  occurredAt   DateTime              @db.Timestamptz(6)
  receivedAt   DateTime              @default(now()) @db.Timestamptz(6)
  processedAt  DateTime?             @db.Timestamptz(6)
  error        String?               @db.VarChar(1000)
  credential   IntegrationCredential @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  emailEvent   EmailEvent?           @relation(fields: [emailEventId], references: [id], onDelete: Restrict)

  @@unique([credentialId, svixEventId])
  @@index([emailEventId, occurredAt])
  @@map("EmailWebhookEvent")
}

model CmsMedia {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storageKey           String    @db.VarChar(500)
  contentHash          Bytes     @db.ByteA
  originalFilename     String    @db.VarChar(255)
  mimeType             String    @db.VarChar(100)
  altText              String    @db.VarChar(250)
  byteSize             Int
  width                Int?
  height               Int?
  derivatives          Json      @db.JsonB
  createdByAdminUserId String    @db.Uuid
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deletedAt            DateTime? @db.Timestamptz(6)
  createdBy            AdminUser @relation(fields: [createdByAdminUserId], references: [id], onDelete: Restrict)

  @@index([deletedAt, createdAt])
  @@map("CmsMedia")
}


enum LoyaltyTxnType {
  EARN
  EARN_REVERSAL
  REFERRAL_EARN
  REFERRAL_REVERSAL
  FORFEIT
}

enum ReferralStatus {
  ATTRIBUTED
  QUALIFIED
  REJECTED
  REVERSED
}

model ReferralCode {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String     @unique @db.Uuid
  code        String     @unique @db.VarChar(12)
  disabledAt  DateTime?  @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  referrals   Referral[]

  @@index([disabledAt, createdAt])
  @@map("ReferralCode")
}

model Referral {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codeId              String         @db.Uuid
  referrerCustomerId  String         @db.Uuid
  referredCustomerId  String         @unique @db.Uuid
  orderId             String?        @unique @db.Uuid
  status              ReferralStatus @default(ATTRIBUTED)
  rejectionReason     String?        @db.VarChar(80)
  qualifiedAt         DateTime?      @db.Timestamptz(6)
  reversedAt          DateTime?      @db.Timestamptz(6)
  createdAt           DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  code                ReferralCode   @relation(fields: [codeId], references: [id], onDelete: Restrict)
  referrer            Customer       @relation("ReferralReferrer", fields: [referrerCustomerId], references: [id], onDelete: Restrict)
  referred            Customer       @relation("ReferralReferred", fields: [referredCustomerId], references: [id], onDelete: Restrict)
  order               Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  loyaltyTxns         LoyaltyTxn[]

  @@index([referrerCustomerId, status, createdAt])
  @@index([codeId, status, createdAt])
  @@index([status, createdAt])
  @@map("Referral")
}

model LoyaltyTxn {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId    String          @db.Uuid
  orderId       String          @db.Uuid
  refundId      String?         @db.Uuid
  referralId    String?         @db.Uuid
  type          LoyaltyTxnType
  points        Int
  balanceAfter  Int
  operationKey  String          @unique @db.VarChar(128)
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refund        OrderRefund?    @relation(fields: [refundId], references: [id], onDelete: Restrict)
  referral      Referral?       @relation(fields: [referralId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt, id])
  @@index([orderId, type, createdAt])
  @@index([refundId, type])
  @@index([referralId, type])
  @@map("LoyaltyTxn")
}
