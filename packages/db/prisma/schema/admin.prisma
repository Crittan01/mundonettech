enum AdminRole {
  SUPERADMIN
  OPERATIONS_MANAGER
  STORE_MANAGER
  INVENTORY_BUYER
  FULFILLMENT
  CUSTOMER_SUPPORT
  FINANCE_ANALYST
  CMS_EDITOR
}

enum AdminUserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum IntegrationEnvironment {
  LOCAL
  STG
  PRD
}

model AdminUser {
  id                       String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId               String                  @db.Uuid
  email                    String                  @db.VarChar(320)
  displayName              String                  @db.VarChar(120)
  role                     AdminRole
  status                   AdminUserStatus         @default(INVITED)
  mfaEnrolledAt            DateTime?               @db.Timestamptz(6)
  lastSignInAt             DateTime?               @db.Timestamptz(6)
  createdAt                DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  deletedAt                DateTime?               @db.Timestamptz(6)
  recoveryCodes            AdminRecoveryCode[]
  initiatedLogs            AdminActionLog[]        @relation("AdminActionActor")
  targetedLogs             AdminActionLog[]        @relation("AdminActionTarget")
  securityEvents           SecurityEvent[]
  credentials              IntegrationCredential[] @relation("CredentialCreator")
  rotations                IntegrationCredential[] @relation("CredentialRotator")
  storeSettings            StoreSettings[]
  cmsVersions              CmsBlockVersion[]
  cmsMedia                 CmsMedia[]
  assistedCarts            Cart[]
  requestedRefunds         OrderRefund[]
  confirmedPaymentAttempts PaymentAttempt[]        @relation("PaymentAttemptConfirmer")
  blockedIdentities        BlockedIdentity[]       @relation("IdentityBlocker")
  unblockedIdentities      BlockedIdentity[]       @relation("IdentityUnblocker")
  remittanceBatches        RemittanceBatch[]
  codReconciliations       CodReconciliation[]
  storeCreditEntries       StoreCreditEntry[]
  shipmentEvents           ShipmentEvent[]
  createdDeliveryZones     LocalDeliveryZone[]     @relation("DeliveryZoneCreator")
  updatedDeliveryZones     LocalDeliveryZone[]     @relation("DeliveryZoneUpdater")
  emailTemplateOverrides   EmailTemplateOverride[]
  notificationReads        NotificationRead[]
  reviewedReturnRequests   ReturnRequest[]         @relation("ReturnRequestReviewer")
  reviewedWarrantyClaims   WarrantyClaim[]         @relation("WarrantyClaimReviewer")
  assignedSupportTickets   SupportTicket[]         @relation("SupportTicketAssignee")
  supportMessages          SupportTicketMessage[]  @relation("SupportMessageAuthor")
  moderatedReviews         Review[]                @relation("ReviewModerator")
  contactActivities        ContactActivity[]       @relation("ContactActivityAuthor")
  assignedCrmTasks         Task[]                  @relation("TaskAssignee")
  createdCrmTasks          Task[]                  @relation("TaskCreator")
  approvedIdentityMerges   IdentityMergeCandidate[] @relation("IdentityMergeApprover")
  rejectedIdentityMerges   IdentityMergeCandidate[] @relation("IdentityMergeRejector")
  reversedIdentityMerges   IdentityMergeCandidate[] @relation("IdentityMergeReverser")
  createdB2bProposals       OpportunityProposal[] @relation("B2bProposalCreator")
  requestedB2bCopilotRuns   OpportunityCopilotRun[] @relation("B2bCopilotRequester")
  createdCustomerSegments   CustomerSegment[] @relation("CustomerSegmentCreator")
  updatedCustomerSegments   CustomerSegment[] @relation("CustomerSegmentUpdater")
  createdLifecycleJourneys  LifecycleJourney[] @relation("LifecycleJourneyCreator")
  updatedLifecycleJourneys  LifecycleJourney[] @relation("LifecycleJourneyUpdater")
  createdChannelAccounts    ChannelAccount[] @relation("ChannelAccountCreator")
  createdChannelOAuthAttempts ChannelOAuthAttempt[] @relation("ChannelOAuthAttemptCreator")
  createdChannelListings    ChannelListing[] @relation("ChannelListingCreator")
  createdChannelSyncJobs    ChannelSyncJob[] @relation("ChannelSyncJobCreator")
  createdChannelLedgerEntries ChannelLedgerEntry[] @relation("ChannelLedgerEntryCreator")
  reconciledMetaCapiEvents MetaCapiEvent[] @relation("MetaCapiReconciler")

  @@index([role, status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("AdminUser")
}

model AdminRecoveryCode {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId String    @db.Uuid
  codeHash    Bytes     @db.ByteA
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt   DateTime  @db.Timestamptz(6)
  consumedAt  DateTime? @db.Timestamptz(6)
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@unique([adminUserId, codeHash])
  @@index([adminUserId, expiresAt, consumedAt])
  @@map("AdminRecoveryCode")
}

model AdminActionLog {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorAdminUserId  String     @db.Uuid
  targetAdminUserId String?    @db.Uuid
  action            String     @db.VarChar(100)
  targetType        String     @db.VarChar(100)
  targetId          String?    @db.VarChar(255)
  requestId         String?    @db.Uuid
  ipHash            Bytes?     @db.ByteA
  userAgentHash     Bytes?     @db.ByteA
  metadata          Json       @default("{}") @db.JsonB
  selfDealing       Boolean    @default(false)
  createdAt         DateTime   @default(now()) @db.Timestamptz(6)
  actor             AdminUser  @relation("AdminActionActor", fields: [actorAdminUserId], references: [id], onDelete: Restrict)
  target            AdminUser? @relation("AdminActionTarget", fields: [targetAdminUserId], references: [id], onDelete: Restrict)

  @@index([actorAdminUserId, createdAt])
  @@index([targetAdminUserId, createdAt])
  @@index([selfDealing, createdAt])
  @@index([requestId])
  @@map("AdminActionLog")
}

model SecurityEvent {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId   String?    @db.Uuid
  customerId    String?    @db.Uuid
  eventType     String     @db.VarChar(100)
  ipHash        Bytes      @db.ByteA
  userAgentHash Bytes?     @db.ByteA
  metadata      Json       @default("{}") @db.JsonB
  occurredAt    DateTime   @default(now()) @db.Timestamptz(6)
  dedupMinute   DateTime   @default(now()) @db.Timestamptz(6)
  adminUser     AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  customer      Customer?  @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([eventType, ipHash, dedupMinute])
  @@index([adminUserId, occurredAt])
  @@index([customerId, occurredAt])
  @@map("SecurityEvent")
}

model IntegrationCredential {
  id                       String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider                 String                 @db.VarChar(100)
  environment              IntegrationEnvironment
  accountName              String                 @db.VarChar(120)
  keyVersion               Int
  nonce                    Bytes                  @db.ByteA
  ciphertext               Bytes                  @db.ByteA
  authTag                  Bytes                  @db.ByteA
  createdByAdminUserId     String                 @db.Uuid
  lastRotatedByAdminUserId String?                @db.Uuid
  createdAt                DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  revokedAt                DateTime?              @db.Timestamptz(6)
  createdBy                AdminUser              @relation("CredentialCreator", fields: [createdByAdminUserId], references: [id], onDelete: Restrict)
  lastRotatedBy            AdminUser?             @relation("CredentialRotator", fields: [lastRotatedByAdminUserId], references: [id], onDelete: Restrict)
  paymentAttempts          PaymentAttempt[]
  fulfillments             OrderFulfillment[]
  shipmentPackages         ShipmentPackage[]
  emailEvents              EmailEvent[]
  emailWebhookEvents       EmailWebhookEvent[]
  taxInvoices              TaxInvoice[]
  creditNotes              CreditNote[]
  b2bCopilotRuns           OpportunityCopilotRun[]
  channelAccount           ChannelAccount?
  channelOAuthAttempt      ChannelOAuthAttempt?
  metaCapiEvents           MetaCapiEvent[]

  @@index([environment, revokedAt])
  @@index([environment, createdAt, id])
  @@index([createdByAdminUserId, createdAt])
  @@map("IntegrationCredential")
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

model Notification {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deduplicationKey String               @unique @db.VarChar(160)
  category         String               @db.VarChar(60)
  severity         NotificationSeverity
  title            String               @db.VarChar(160)
  message          String               @db.VarChar(500)
  href             String               @db.VarChar(255)
  entityType       String?              @db.VarChar(80)
  entityId         String?              @db.VarChar(128)
  createdAt        DateTime             @default(now()) @db.Timestamptz(6)
  resolvedAt       DateTime?            @db.Timestamptz(6)
  reads            NotificationRead[]

  @@index([resolvedAt, severity, createdAt])
  @@index([category, resolvedAt, createdAt])
  @@map("Notification")
}

model NotificationRead {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String       @db.Uuid
  adminUserId    String       @db.Uuid
  readAt         DateTime     @default(now()) @db.Timestamptz(6)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  adminUser      AdminUser    @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@unique([notificationId, adminUserId])
  @@index([adminUserId, readAt])
  @@map("NotificationRead")
}
