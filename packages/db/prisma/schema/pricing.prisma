enum WholesaleTierScope {
  GLOBAL
  CATEGORY
  PRODUCT
  VARIANT
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CouponStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CouponUsageStatus {
  RESERVED
  REDEEMED
  RELEASED
}

model WholesaleTier {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope           WholesaleTierScope
  variantId       String?            @db.Uuid
  productId       String?            @db.Uuid
  categoryId      String?            @db.Uuid
  minimumQuantity Int
  unitPriceCents  BigInt
  active          Boolean            @default(true)
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime?          @db.Timestamptz(6)
  variant         ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  product         Product?           @relation(fields: [productId], references: [id], onDelete: Restrict)
  category        Category?          @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([variantId, active, minimumQuantity])
  @@index([productId, active, minimumQuantity])
  @@index([categoryId, active, minimumQuantity])
  @@index([scope, active, deletedAt])
  @@map("WholesaleTier")
}

model Coupon {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                 String             @db.VarChar(64)
  name                 String             @db.VarChar(160)
  discountType         CouponDiscountType
  status               CouponStatus       @default(DRAFT)
  percentageBps        Int?
  amountCents          BigInt?
  maximumDiscountCents BigInt?
  minimumSubtotalCents BigInt             @default(0)
  startsAt             DateTime?          @db.Timestamptz(6)
  endsAt               DateTime?          @db.Timestamptz(6)
  maximumUsages        Int?
  perCustomerUsages    Int?
  createdAt            DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  deletedAt            DateTime?          @db.Timestamptz(6)
  products             CouponProduct[]
  categories           CouponCategory[]
  usages               CouponUsage[]
  carts                Cart[]

  @@index([status, startsAt, endsAt, deletedAt])
  @@map("Coupon")
}

model CouponProduct {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  couponId  String   @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([couponId, productId])
  @@index([productId, couponId])
  @@map("CouponProduct")
}

model CouponCategory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  couponId   String   @db.Uuid
  categoryId String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([couponId, categoryId])
  @@index([categoryId, couponId])
  @@map("CouponCategory")
}

model CouponUsage {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  couponId   String            @db.Uuid
  cartId     String            @db.Uuid
  customerId String?           @db.Uuid
  status     CouponUsageStatus @default(RESERVED)
  reservedAt DateTime          @default(now()) @db.Timestamptz(6)
  expiresAt  DateTime          @db.Timestamptz(6)
  redeemedAt DateTime?         @db.Timestamptz(6)
  releasedAt DateTime?         @db.Timestamptz(6)
  createdAt  DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  coupon     Coupon            @relation(fields: [couponId], references: [id], onDelete: Restrict)
  cart       Cart              @relation(fields: [cartId], references: [id], onDelete: Restrict)
  customer   Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([couponId, status, expiresAt])
  @@index([couponId, customerId, status, expiresAt])
  @@index([cartId, status])
  @@map("CouponUsage")
}
