{
  "name": "@mundonettech/media",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./dist/sharp-safe.js",
    "./src/sharp-safe.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./viewers": {
      "types": "./dist/viewers.d.ts",
      "import": "./dist/viewers.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1177.0",
    "@aws-sdk/lib-storage": "3.1177.0",
    "@google/model-viewer": "4.4.0",
    "@mundonettech/core": "workspace:*",
    "@mundonettech/db": "workspace:*",
    "sharp": "0.35.5",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "peerDependencies": {
    "next": ">=16.0.0",
    "react": ">=19.0.0"
  }
}
