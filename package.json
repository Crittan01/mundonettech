{
  "name": "mundonettech",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "check": "pnpm guards && pnpm lint && pnpm format:check && pnpm typecheck",
    "db:migrate": "pnpm --filter @mundonettech/db db:migrate",
    "db:seed": "turbo run build --filter=@mundonettech/config --filter=@mundonettech/core --filter=@mundonettech/db && node scripts/seed-catalog.mjs",
    "db:start": "node scripts/supabase-local.mjs start && pnpm db:migrate && node scripts/local-development-env.mjs",
    "db:status": "node scripts/supabase-local.mjs status",
    "db:stop": "node scripts/supabase-local.mjs stop",
    "db:validate": "pnpm --filter @mundonettech/db db:validate",
    "db:verify": "pnpm --filter @mundonettech/db verify-security-posture && node scripts/verify-local-stack.mjs",
    "dev": "node scripts/local-development-env.mjs && turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "guard:boundaries": "node scripts/check-boundaries.mjs",
    "guard:docs": "node scripts/check-docs.mjs",
    "guard:git": "node scripts/check-git-hygiene.mjs",
    "guard:language": "node scripts/check-language.mjs",
    "guard:test-env": "NODE_ENV=test EMAIL_SEND_DISABLED=1 node scripts/check-test-env.mjs",
    "guards": "pnpm guard:docs && pnpm guard:git && pnpm guard:language && pnpm guard:boundaries && pnpm guard:test-env",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm guard:test-env && turbo run build --filter=@mundonettech/config --filter=@mundonettech/core --filter=@mundonettech/db --filter=@mundonettech/integrations --filter=@mundonettech/media --filter=@mundonettech/cms && pnpm test:unit && pnpm test:integration",
    "test:e2e": "pnpm guard:test-env && EMAIL_SEND_DISABLED=1 turbo run build --filter=@mundonettech/web && NODE_ENV=test EMAIL_SEND_DISABLED=1 node scripts/test-e2e.mjs",
    "test:integration": "NODE_ENV=test EMAIL_SEND_DISABLED=1 node --test --test-concurrency=1 tests/*.test.mjs",
    "test:rls": "NODE_ENV=test EMAIL_SEND_DISABLED=1 node scripts/rls-matrix.mjs",
    "test:unit": "NODE_ENV=test EMAIL_SEND_DISABLED=1 vitest run",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json --noEmit",
    "web:verify": "node scripts/verify-web-security.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.65.1",
    "@supabase/supabase-js": "2.119.2",
    "@types/node": "^22.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^16.4.0",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "supabase": "2.109.1",
    "tailwindcss": "4.3.5",
    "turbo": "2.11.13",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^5.1.1"
  }
}
