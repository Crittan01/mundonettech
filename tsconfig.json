{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/web/*"]
    }
  },
  "include": [
    "apps/web/next-env.d.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "e2e/**/*.ts",
    "tests/vitest/**/*.ts",
    "tests/a2-routes-public/**/*.ts",
    "tests/helpers/*.d.mts",
    "scripts/lib/*.d.mts"
  ]
}
